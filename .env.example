# Copie para .env (que está no .gitignore) e troque os valores.
# Regra do SQL Server: 8+ caracteres com maiúscula, minúscula, número e símbolo.
MSSQL_SA_PASSWORD=Troque-Esta-Senha-123

# Só para a Api em container (docker compose --profile app). 32+ caracteres aleatórios:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   bash:       openssl rand -base64 48
JWT_SIGNING_KEY=
